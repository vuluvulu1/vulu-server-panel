# Panelin dinlediği adres. 127.0.0.1 = yalnızca bu bilgisayar.
# Telefon/başka bilgisayardan (aynı Wi-Fi) yönetmek için 0.0.0.0 yap ve paneli yeniden başlat.
PANEL_HOST=127.0.0.1
PANEL_PORT=8000
PANEL_SECRET_KEY=bunu-uzun-rastgele-bir-seyle-degistir
# PaperMC indirme servisi iletişim bilgisi ister (e-posta ya da site adresin):
PANEL_CONTACT=
# VDS'te alan adıyla erişeceksen (virgülle ayır):
PANEL_ALLOWED_HOSTS=
