# Bu dosyayı doldurmak zorunlu değil: aşağıdaki her ayar panelden de değiştirilebilir
# (Ayarlar → Panel ayarları) ve panelden kaydedilen değer buradakinin yerine geçer.

# Panelin dinlediği adres. 127.0.0.1 = yalnızca bu bilgisayar.
# Telefon/başka bilgisayardan (aynı Wi-Fi) yönetmek için 0.0.0.0 yap ve paneli yeniden başlat.
PANEL_HOST=127.0.0.1
PANEL_PORT=8000

# İsteğe bağlı: dış servislere (PaperMC, Modrinth…) iletişim bilgisi olarak gönderilir.
# Boş bırakılırsa projenin GitHub adresi kullanılır.
PANEL_CONTACT=

# VDS'te alan adıyla erişeceksen (virgülle ayır):
PANEL_ALLOWED_HOSTS=
